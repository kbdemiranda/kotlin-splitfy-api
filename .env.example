# Database
DB_URL=jdbc:postgresql://localhost:5432/splitfy
DB_USER=postgres
DB_PASSWORD=change-me

# JWT
JWT_SECRET=replace-with-a-strong-secret-with-at-least-32-bytes
JWT_EXPIRATION_MS=3600000

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Mail
MAIL_USERNAME=smtp-user@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=Splitfy <no-reply@example.com>

# Billing
PIX_KEY=123.456.789-00
PIX_COPY_PASTE=000000000000...

# Redis
# REDIS_HOST/REDIS_PORT: used when the API runs on your machine (outside Docker).
#   With Redis from this repository's docker-compose, use localhost + REDIS_EXTERNAL_PORT.
# DOCKER_REDIS_HOST/DOCKER_REDIS_PORT: used by the backend container (Compose service name + internal port).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TIMEOUT=2s

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4242,http://127.0.0.1:4242

# Docker production ports (optional)
BACKEND_PORT=9090
FRONTEND_PORT=4242
REDIS_EXTERNAL_PORT=16379
